<link rel="preload" href="{{ 'responsive.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'responsive.css' | asset_url }}"></noscript>
<link rel="preload" href="{{ 'flickity.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'flickity.min.css' | asset_url }}"></noscript>

<style>
   {% assign swatchesColor = settings.swatchs_custom_value | newline_to_br %}
  {% assign swatchesColor = swatchesColor | split: '<br />' %}
  {% for color in swatchesColor %}
    {% assign colorValue = color | strip | split: ':' %}
    [data-color="{{- colorValue.first -}}"]{
      {%- if colorValue.last contains '#' -%}
         background-color: {{- colorValue.last -}}!important;
      {%- else -%}
         background-image:url({{ colorValue.last }}) !important;
      {%- endif -%}
    }
  {% endfor %}
</style>
<script>
window.routes = {
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_change_url: '{{routes.cart_change_url }}',
    cart_update_url: '{{routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}',
    predictive_search_url:'{{ routes.search_url }}/suggest'
 
};

window.cartStrings = {
  error: `{{ 'sections.cart.cart_error' | t }}`,
  quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
  empty: `{{ 'sections.cart.empty' | t }}`,
  shop_now: `Shop Now`
}
window.variantStrings = {
  addToCart: `{{'products.product.add_to_cart' | t }}`,
  soldOut: `{{ 'products.product.sold_out' | t }}`,
  unavailable: `{{ 'products.product.unavailable' | t }}`,
  unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: option_value }}`
}

const animationCheck = {{ settings.animation_enable }};
const googleMapApiKey = `{{ settings.google_map_api }}`;
const mapID = `{{ settings.map_id }}`;
const currencyRate = `{{settings.shipping_rate}}`;
const shippingmessage = `{{ settings.shipping_text }}`;
const shippingsuccessmessage = `{{ settings.shipping_success_text }}`;

const shippingStatus ={{ settings.show_shipping }}
const ON_CHANGE_DEBOUNCE_TIMER = 300;
const PUB_SUB_EVENTS = {
  cartUpdate: 'cart-update',
  quantityUpdate: 'quantity-update',
  variantChange: 'variant-change',
  cartError: 'cart-error'
};
  const storeLoader='<div class="loader-state"><svg height="18" width="18" class="loader-icon"><circle r="7" cx="9" cy="9"></circle><circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9"></circle></svg></div>';
</script>

