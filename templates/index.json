    "image_with_text_Qxyj3C": {
      "type": "image-with-text",
      "blocks": {
        "heading_km97Qt": {
          "type": "heading",
          "settings": {
            "heading": "Voice is so lovely to hear, it gives us strength.",
            "heading_size": "h2",
            "heading_size_mobile": "h3_mobile"
          }
        },
        "text_gVbEHf": {
          "type": "text",
          "settings": {
            "text": "<p>A lovely voice can captivate us, drawing us in with its melody and timbre. It has the ability to resonate within us, touching our hearts and igniting our imaginations. Whether it's the gentle whisper of a loved one, the passionate declaration of an orator, or the melodic tones of a singer, a beautiful voice has the extraordinary ability to uplift our spirits and give us strength.</p>"
          }
        }
      },
      "block_order": [
        "heading_km97Qt",
