{%- endif -%}

{% schema %}
{
  "name": "PU - Product Tabs #01",
  "settings": [
    {
      "type": "header",
      "content": "Placement"
    },
    {
      "type": "select",
      "id": "placement_mode",
      "label": "Placement",
      "default": "below_add_to_cart",
      "options": [
        { "value": "below_add_to_cart", "label": "Below add-to-cart" },
        { "value": "above_add_to_cart", "label": "Above add-to-cart" },
        { "value": "custom", "label": "Custom placement" }
      ]
    },
    {
      "type": "textarea",
      "id": "placement_custom_code_snippet",
      "label": "Custom placement code snippet",
      "default": "<div data-pu-product-tabs-01-target><\/div>",
      "info": "Paste this code snippet on your store page where you want the section to show.",
      "visible_if": "{{ section.settings.placement_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "targeting_mode",
      "label": "Show on",
      "default": "all",
      "options": [
        { "value": "all", "label": "All products" },
        { "value": "selected_products", "label": "Selected products" },
        { "value": "products_in_collection", "label": "Products in collection" },
        { "value": "products_with_tags", "label": "Products with tags" }
      ]
    },
    {
      "type": "product_list",
      "id": "targeting_selected_products",
      "label": "Selected products"
    },
    {
      "type": "collection",
      "id": "targeting_product_collection",
      "label": "Product collection"
    },
    {
      "type": "textarea",
      "id": "targeting_product_tags",
      "label": "Product tags",
      "info": "Example: tag1,tag2,tag3"
    },

    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding right",
      "default": 0
    },

    {
      "type": "header",
      "content": "Tab title"
    },
    {
      "type": "color",
      "id": "tab_title_background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "checkbox",
      "id": "tab_title_use_theme_font",
      "label": "Use theme font",
      "default": true
