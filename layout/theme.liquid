<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#EB5C20">
    <meta name="robots" content="index, follow">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preload" href="{{ 'custom-global.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'custom-global.css' | asset_url }}"></noscript>
    {% render 'meta-tags' %}
    {% render 'seo-schema' %}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    <link rel="preload" href="{{ 'poppins_n4.0ba78fa7287f843e27c9c0ab593de2cb6c21e2b9.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'poppins_i7.42fd71d30859202f8c8cde020bf72a48bb0f05a6.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    <meta name="description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
    {{ content_for_header }}
    {%- if request.page_type == 'index' -%}
      {%- for section in template.sections -%}
        {%- if section.type == 'slideshow' -%}
          {%- assign first_block = section.blocks | first -%}
          {%- if first_block.settings.image_desktop != blank -%}
            <link
              rel="preload"
              as="image"
              href="{{ first_block.settings.image_desktop | image_url: width: 1920 }}"
              fetchpriority="high"
              imagesrcset="{{ first_block.settings.image_desktop | image_url: width: 480 }} 480w, {{ first_block.settings.image_desktop | image_url: width: 768 }} 768w, {{ first_block.settings.image_desktop | image_url: width: 1024 }} 1024w, {{ first_block.settings.image_desktop | image_url: width: 1440 }} 1440w, {{ first_block.settings.image_desktop | image_url: width: 1920 }} 1920w"
              imagesizes="100vw"
            >
          {%- endif -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {% render 'style-variable' %}
    {% render 'theme-variable' %}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>
  <body class="{% if template == 'cart' %}template-cart{% endif %} main-wrapper">
    <a class="btn unstyled-link skip-to-content-link  focus-inside" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    {% sections 'header-group' %}
    {% sections 'Overlay-group' %}
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'quick-view-model' %}
    {% render 'mini-cart-drawer' %}
    {% render 'back-to-top' %}
    <script>
      {% if settings.animation_enable %}
        window.addEventListener('load', function () {
          AOS.init({
              easing: 'ease',
              once: true,
              duration: 1000,
              offset: 60,
              disableMutationObserver: true,
          });
        });
      {% endif %}
    </script>
    {%- if settings.enable_search_drawer -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
