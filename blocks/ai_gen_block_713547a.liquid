{% doc %}
  @prompt
    产品详情页 生成一个自定义tabs  tabs的标题和内容都可以自定义  内容可以使用自定义liquid代码片段
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-tabs-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding:0 20px;
    display: block;
  }

  .ai-custom-tabs__nav-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_gap }}px;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.content_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-custom-tabs__button-{{ ai_gen_id }} {
    padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
    background: {{ block.settings.tab_bg_color }};
    color: {{ block.settings.tab_text_color }};
    border: none;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: {{ block.settings.tab_font_weight }};
    transition: all 0.3s ease;
    border-bottom: {{ block.settings.border_width }}px solid transparent;
    margin-bottom: -{{ block.settings.border_width }}px;
    border-radius: {{ block.settings.tab_border_radius }}px {{ block.settings.tab_border_radius }}px 0 0;
  }

  .ai-custom-tabs__button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.tab_hover_bg_color }};
    color: {{ block.settings.tab_hover_text_color }};
  }

  .ai-custom-tabs__button-{{ ai_gen_id }}.active {
    background: {{ block.settings.tab_active_bg_color }};
    color:  {{ block.settings.tab_active_text_color }};
    border-bottom-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-custom-tabs__content-{{ ai_gen_id }} {
    display: none;
    padding: {{ block.settings.content_padding }}px;
    background: {{ block.settings.content_bg_color }};
    color: {{ block.settings.content_text_color }};
    border-radius: 0 {{ block.settings.content_border_radius }}px {{ block.settings.content_border_radius }}px {{ block.settings.content_border_radius }}px;
    line-height: 1.6;
  }

  .ai-custom-tabs__content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-custom-tabs__content-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-custom-tabs__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-tabs__nav-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_gap | times: 0.5 }}px;
    }

    .ai-custom-tabs__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
      padding: {{ block.settings.tab_padding_vertical | times: 0.8 }}px {{ block.settings.tab_padding_horizontal | times: 0.8 }}px;
    }

    .ai-custom-tabs__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<custom-tabs-{{ ai_gen_id }} class="ai-custom-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-tabs__nav-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_title_key = 'tab_' | append: i | append: '_title'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_title = block.settings[tab_title_key]
      %}
      
      {% if tab_enabled and tab_title != blank %}
        <button
          class="ai-custom-tabs__button-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-tab="tab-{{ i }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          role="tab"
        >
          {{ tab_title }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-custom-tabs__panels-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_content_key = 'tab_' | append: i | append: '_content'
        assign tab_liquid_key = 'tab_' | append: i | append: '_liquid'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_content = block.settings[tab_content_key]
        assign tab_liquid = block.settings[tab_liquid_key]
      %}
      
      {% if tab_enabled %}
        <div
          class="ai-custom-tabs__content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-tab-content="tab-{{ i }}"
          role="tabpanel"
        >
          {% if tab_liquid != blank %}
            {{ tab_liquid }}
          {% elsif tab_content != blank %}
            {{ tab_content }}
          {% else %}
            <p style="color: #999; font-style: italic;">请在设置中添加此标签页的内容</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</custom-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-custom-tabs__button-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-custom-tabs__content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const targetTab = button.getAttribute('data-tab');
            this.switchTab(targetTab);
          });
        });
      }

      switchTab(targetTab) {
        this.buttons.forEach((btn) => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });

        this.contents.forEach((content) => {
          content.classList.remove('active');
        });

        const activeButton = this.querySelector(`[data-tab="${targetTab}"]`);
        const activeContent = this.querySelector(`[data-tab-content="${targetTab}"]`);

        if (activeButton && activeContent) {
          activeButton.classList.add('active');
          activeButton.setAttribute('aria-selected', 'true');
          activeContent.classList.add('active');
        }
      }
    }

    customElements.define('custom-tabs-{{ ai_gen_id }}', CustomTabs{{ ai_gen_id }});
  })();
</script>

